@model IEnumerable<TravelExpertsData.Migrations.BookingDTO>

@{
    ViewData["Title"] = "MyBookings";
}

<h1>MyBookings</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
