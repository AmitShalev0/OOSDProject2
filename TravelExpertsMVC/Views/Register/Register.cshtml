@model TravelExpertsData.Customer
@{
    ViewData["Title"] = "Register";
}
<head>
    <environment>
        <link rel="stylesheet" type="text/css" href="~/css/site.css" />
        <link href="~/css/loginregister.css" rel="stylesheet" />
        <script src="~/js/LoginRegister.js"></script>
    </environment>
</head>

<h1>Register</h1>

<hr />

<div class="row">
    <div class="field">
        <div class="col-md-4">
            <form asp-action="Register">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label asp-for="CustUserName" class="control-label">Username</label>
                        <input type="text" asp-for="CustUserName" class="form-control" placeholder=" " />
                        <span asp-validation-for="CustUserName" class="text-danger"></span>

                    </div>
                    <div class="col-md-4 form-group">
                        <label asp-for="CustPassword" class="control-label">Password</label>
                        <input type="password" asp-for="CustPassword" class="form-control" id="password" name="password" placeholder=" " />
                        <span asp-validation-for="CustPassword" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 form-group">
                        <label asp-for="CustConfirmPassword" class="control-label">Confirm Password</label>
                        <input type="password" asp-for="CustConfirmPassword" class="form-control id="password" name="confirmed password" placeholder=" " />
                        <span asp-validation-for="CustConfirmPassword" class="text-danger" id="eyeCon"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="CustFirstName" class="control-label">First Name</label>
                        <input asp-for="CustFirstName" class="form-control" placeholder=" " />
                        <span asp-validation-for="CustFirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="CustLastName" class="control-label">Last Name</label>
                        <input type="text" asp-for="CustLastName" class="form-control" placeholder=" " />
                        <span asp-validation-for="CustLastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 form-group">
                        <label asp-for="CustAddress" class="control-label">Address</label>
                        <input type="test" asp-for="CustAddress" class="form-control" placeholder=" " />
                        <span asp-validation-for="CustAddress" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="CustCity" class="control-label">City</label>
                        <input test="type" asp-for="CustCity" class="form-control" placeholder=" " />
                        <span asp-validation-for="CustCity" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="CustProv" class="control-label">Province</label>
                        <select name="CustProv" asp-items="@ViewBag.Provinces" class="form-select">
                            <option value=""></option>
                        </select>
                        <span asp-validation-for="CustProv" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="CustPostal" class="control-label">Postal Code</label>
                        <input type="text" asp-for="CustPostal" class="form-control" placeholder=" " />
                        <span asp-validation-for="CustPostal" class="text-danger"></span>
                    </div>
                
                    <div class="col-md-6 form-group">
                        <label asp-for="CustCountry" class="control-label">Country</label>
                        <input type="text" asp-for="CustCountry" class="form-control" placeholder=" " />
                        <span asp-validation-for="CustCountry" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label asp-for="CustHomePhone" class="control-label"Home Phone>Home #</label>
                        <input type="text" asp-for="CustHomePhone" class="form-control" placeholder=" " />
                        <span asp-validation-for="CustHomePhone" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 form-group">
                        <label asp-for="CustBusPhone" class="control-label">Business #</label>
                        <input type="text" asp-for="CustBusPhone" class="form-control" placeholder=" " />
                        <span asp-validation-for="CustBusPhone" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 form-group">
                        <label asp-for="CustEmail" class="control-label">Email</label>
                        <input type="text" asp-for="CustEmail" class="form-control" placeholder=" "/>
                        <span asp-validation-for="CustEmail" class="text-danger"></span>
                    </div>
                </div>
                <br />
                    <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>



